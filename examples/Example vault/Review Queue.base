filters:
  and:
    - or:
        - type == "study"
        - type == "lesson"
    - confidence
    - last_reviewed
    - formula.next_review <= today()
formulas:
  next_review: 'if(confidence && last_reviewed, last_reviewed + if(confidence == 1, "1d", if(confidence == 2, "3d", if(confidence == 3, "7d", "21d"))), "")'
properties:
  formula.next_review:
    displayName: Next review
views:
  - type: table
    name: Due for review
    order:
      - file.name
      - confidence
      - last_reviewed
      - formula.next_review
    sort:
      - property: formula.next_review
        direction: ASC
